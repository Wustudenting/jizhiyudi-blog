# 复制这个文件为 .env 再填真实值。.env 已被 .gitignore 忽略，切勿提交。

# JWT 签名密钥（生产环境务必改成随机串）
JWT_SECRET=

# ---- 语雀同步 ----
# 浏览器登录语雀后，F12 → Network → 刷新 → 点开任意请求（比如 mine）
#   → Headers → Request Headers → 复制整行 Cookie 的值
# 必须包含 _yuque_session 和 yuque_ctoken 两项。
# 不要从 DevTools 的 Cookie 面板逐条复制：那里的长值会被截断成 "..."
YUQUE_COOKIE=

# 要同步的知识库 id，逗号分隔。留空 = 同步全部
# 先跑 `npm run sync:yuque -- --list` 查看可用的 id
YUQUE_BOOK_IDS=
